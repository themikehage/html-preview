{
  "name": "html-preview",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "bun run --hot apps/server/src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome check .",
    "check:size": "bun scripts/check-size.ts",
    "check:license": "bun scripts/check-license.ts",
    "test": "bun test",
    "build": "bun build apps/server/src/index.ts --target bun --outdir dist",
    "verify": "bun run typecheck && bun run lint && bun run check:size && bun run check:license && bun run test && bun run build"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  }
}
